[internationalization]

locale/translations=PackedStringArray("res://game/localization/strings.en.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
2d/snap/snap_2d_transforms_to_pixel=true

[tactics_core]

ruleset/default_path="res://game/rules/crossroads_ruleset.tres"
log/level=0
